# --- device ---
DEVICE_ID=marcos-01
DEVICE_TOKEN=change-me
GATEWAY_URL=ws://localhost:8000/ws
# trecho do nome (ex.: Fifine) ou indice numerico; vazio = padrao do sistema.
# `python -m sounddevice` lista os dispositivos.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
DISPLAY_MODE=window

# STT local (decisao D1): tamanho small acerta, base cabe com folga (D9)
STT_MODEL=small
STT_COMPUTE_TYPE=int8
STT_MODEL_DIR=lab/models/faster-whisper
# quanto silencio encerra a fala, e o quanto o VAD e agressivo (0-3)
VAD_SILENCE_MS=700
VAD_AGGRESSIVENESS=3

# a voz do assistente: sintese roda no dispositivo (decisao D1)
TTS_VOICE=pt_BR-ideraldo-medium
TTS_VOICE_DIR=lab/models/piper
# simulated network latency: 80 = wifi, 150 = 4G
SIMULATED_LATENCY_MS=0

# timers e alarmes: em disco, para sobreviver a um reinicio (fase 2)
SCHEDULES_DB=device/data/schedules.db

# --- gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ollama (local, no key) | swap for a cloud provider later
LLM_PROVIDER=ollama
# qwen3:8b, e nao llama3.1:8b: com ferramentas declaradas o llama para de
# responder conhecimento geral (D19/D20). `ollama pull qwen3:8b`.
LLM_MODEL=qwen3:8b
# o qwen3 raciocina por padrao: lento para voz, e o rascunho pode virar fala
LLM_THINK=false
OLLAMA_URL=http://localhost:11434
# segundos: suba se o modelo local estiver sem GPU livre
LLM_TIMEOUT=120

# --- spotify (opcional) ---
# Sem estas duas, as ferramentas de musica nao sao oferecidas ao modelo.
# App em https://developer.spotify.com/dashboard; exige conta Premium para
# controlar playback. Depois de preencher, rode uma vez:
#   python -m gateway.tools.spotify_auth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# tem que bater EXATAMENTE com o cadastrado no dashboard (127.0.0.1, nao localhost)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_TOKEN_PATH=gateway/data/spotify_token.json
SPOTIFY_MARKET=BR

# only needed if STT or LLM move to cloud providers
LLM_API_KEY=
STT_API_KEY=
