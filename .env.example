# --- device ---
DEVICE_ID=bmo-01
DEVICE_TOKEN=change-me
GATEWAY_URL=ws://localhost:8000/ws
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
DISPLAY_MODE=window

# a voz do assistente: sintese roda no dispositivo (decisao D1)
TTS_VOICE=pt_BR-ideraldo-medium
TTS_VOICE_DIR=lab/models/piper
# simulated network latency: 80 = wifi, 150 = 4G
SIMULATED_LATENCY_MS=0

# --- gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ollama (local, no key) | swap for a cloud provider later
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434
# segundos: suba se o modelo local estiver sem GPU livre
LLM_TIMEOUT=120

# only needed if STT or LLM move to cloud providers
LLM_API_KEY=
STT_API_KEY=
